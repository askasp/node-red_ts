{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@userDir/*": ["./*"],
      "@lib/*": ["./lib/*"],
      "@nodes/*": ["./nodes/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "./lib/**/*",
    "./nodes/**/*",
    "./*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
} 